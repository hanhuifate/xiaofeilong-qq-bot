{
  "manifest_version": 3,
  "name": "小肥龙 · ChatGPT 图片桥接",
  "version": "1.0.0",
  "description": "仅在专用新聊天提交明确的生图请求，将实际图片传回本机 QQ 服务。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "http://127.0.0.1:6103/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "小肥龙图片桥接设置"
  },
  "key": ""
}
